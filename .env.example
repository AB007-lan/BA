# Copiez ce fichier en .env puis remplacez les valeurs. Ne commitez jamais .env.
DJANGO_SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En production derrière HTTPS : https://votre-domaine
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=Africa/Nouakchott

POSTGRES_DB=hissab
POSTGRES_USER=hissab
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-fort
WEB_PORT=8000

# Production (HTTPS derrière un reverse proxy) : passer à 1
DJANGO_BEHIND_PROXY=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0
DJANGO_HSTS_SECONDS=0
